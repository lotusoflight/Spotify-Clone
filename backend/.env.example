# ==========================================
# SPOTIFY CLONE BACKEND ENVIRONMENT TEMPLATE
# For Render & TiDB Cloud Serverless Deployment
# NEVER commit real .env files to GitHub!
# ==========================================

# Django Core Production Settings
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Managed Cloud MySQL Database Settings (e.g. TiDB Cloud Serverless)
USE_MYSQL=True
MYSQL_DATABASE=test
MYSQL_USER=your_cluster_prefix.root
MYSQL_PASSWORD=your_tidb_password
MYSQL_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_SSL_REQUIRED=True

# Spotify Developer API Credentials
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# CORS & CSRF (Include your deployed Vercel frontend domain)
CORS_ALLOWED_ORIGINS=https://your-spotify-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-spotify-app.vercel.app

# Security Headers (Enable for HTTPS in production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
